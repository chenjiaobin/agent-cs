DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 第 5 篇才用得上
DASHSCOPE_API_KEY=

# v0.2 本地开发用 PGlite（WASM 版 Postgres），零安装、不需要 Docker。
# 不填就默认写到项目下的 .data/pg，已被 .gitignore 忽略。
PGLITE_DATA_DIR=

# 第 13 篇上线部署时才用。本地开发不用管这一行：
# PGlite 是嵌入式单进程，连不上也用不到外部 Postgres。
# DATABASE_URL=postgres://user:pass@host:5432/agent_cs
